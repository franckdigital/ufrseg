DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
# Laisser vide pour SQLite en dev. Sinon :
DB_ENGINE=mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Assistant IA (optionnel - un mode local basé sur la FAQ existe sinon)
ANTHROPIC_API_KEY=

# CinetPay (API v1 Aurora) — SANDBOX : clés sk_test_ ; une clé sk_live_ est refusée sauf CINETPAY_ALLOW_LIVE=1
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_SITE_ID=
CINETPAY_ALLOW_LIVE=0
# Simulation locale (DEBUG uniquement) : désactivée automatiquement si clé + mot de passe sont renseignés
CINETPAY_MOCK=1
# URL publique de l'API (notify_url CinetPay : exposer 8010 via un tunnel en local) et du dashboard (retour de paiement)
BACKEND_BASE_URL=http://127.0.0.1:8010
PUBLIC_WEB_URL=http://localhost:5174
